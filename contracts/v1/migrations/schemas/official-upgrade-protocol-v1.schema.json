{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MetaInFLow/EvoZeus-CoEvolve/contracts/v1/migrations/schemas/official-upgrade-protocol-v1.schema.json",
  "title": "EvoZeus official upgrade protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "protocol_version",
    "allowed_operation_types",
    "authority",
    "candidate_policy",
    "target_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "evozeus.coevolve.official-upgrade-protocol.v1"
    },
    "protocol_id": {
      "const": "evozeus-official-upgrade"
    },
    "protocol_version": {
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "allowed_operation_types": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "create_exact",
          "replace_exact",
          "manifest_patch",
          "supervised_transform"
        ]
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery_is_authority",
        "profile_is_data",
        "exact_closure_required",
        "closure_diff_operation_bijection"
      ],
      "properties": {
        "discovery_is_authority": { "const": false },
        "profile_is_data": { "const": true },
        "exact_closure_required": { "const": true },
        "closure_diff_operation_bijection": { "const": true }
      }
    },
    "candidate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_model",
        "protected_base_paths",
        "construction_source_allowlist",
        "protected_legacy_data_prefixes",
        "pull_request_classification",
        "reject_symlinks",
        "reject_submodules",
        "reject_unknown_operations"
      ],
      "properties": {
        "execution_model": { "const": "trusted_base_verifier_candidate_blobs_as_data" },
        "protected_base_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "construction_source_allowlist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prefixes", "paths"],
          "properties": {
            "prefixes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "paths": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "protected_legacy_data_prefixes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "pull_request_classification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority_rotation_prefixes",
            "authority_rotation_paths",
            "data_candidate_prefixes",
            "data_candidate_paths"
          ],
          "properties": {
            "authority_rotation_prefixes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "authority_rotation_paths": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "data_candidate_prefixes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "data_candidate_paths": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "reject_symlinks": { "const": true },
        "reject_submodules": { "const": true },
        "reject_unknown_operations": { "const": true }
      }
    },
    "target_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protected_business_surfaces",
        "rendered_without_receipt",
        "ledger",
        "ledger_history",
        "unknown_or_scattered",
        "supervised_legacy"
      ],
      "properties": {
        "protected_business_surfaces": { "const": "byte_exact" },
        "rendered_without_receipt": { "const": "preserve_byte_exact" },
        "ledger": { "const": "deterministic_no_date_no_self_reference" },
        "ledger_history": { "const": "one_current_hop_plus_zero_or_more_prior_records" },
        "unknown_or_scattered": { "const": "manual_migration_required_zero_write" },
        "supervised_legacy": {
          "const": "exact_envelope_exact_operation_one_time_approval_trusted_kernel_apply"
        }
      }
    }
  }
}
