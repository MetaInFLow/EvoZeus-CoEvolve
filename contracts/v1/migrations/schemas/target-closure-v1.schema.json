{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MetaInFLow/EvoZeus-CoEvolve/contracts/v1/migrations/schemas/target-closure-v1.schema.json",
  "title": "EvoZeus immutable target materialization closure v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "closure_id",
    "closure_version",
    "source",
    "state",
    "files",
    "protected_business_surfaces"
  ],
  "properties": {
    "schema_version": {
      "const": "evozeus.coevolve.target-closure.v1"
    },
    "closure_id": {
      "const": "using-evozeus-harness"
    },
    "closure_version": {
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "construction_revision",
        "release_status",
        "required_release"
      ],
      "properties": {
        "repository": { "const": "MetaInFLow/EvoZeus-CoEvolve" },
        "construction_revision": { "pattern": "^[0-9a-f]{40}$" },
        "release_status": {
          "enum": [
            "unreleased_exact_snapshot",
            "release_required_for_apply"
          ]
        },
        "required_release": {
          "type": ["string", "null"],
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout",
        "target_wrapper_version",
        "contract_bundle_version",
        "harness_skill_version"
      ],
      "properties": {
        "layout": { "const": "consolidated-v2" },
        "target_wrapper_version": { "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "contract_bundle_version": { "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "harness_skill_version": { "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_path", "kind", "mode", "ownership", "materialization"],
        "properties": {
          "target_path": { "$ref": "#/$defs/relativePath" },
          "kind": { "enum": ["absent", "exact", "rendered_template", "manifest_state"] },
          "mode": {
            "description": "Declared target Git mode. For exact files it must equal both artifact and construction-source Git mode unless the single notice materialization exception is declared.",
            "enum": ["absent", "100644", "100755", "virtual"]
          },
          "ownership": { "const": "wrapper_managed" },
          "artifact_path": { "$ref": "#/$defs/relativePath" },
          "source_path": { "$ref": "#/$defs/relativePath" },
          "source_binding": {
            "enum": [
              "construction_revision",
              "required_release",
              "generated_release_artifact"
            ]
          },
          "sha256": { "$ref": "#/$defs/sha256" },
          "materialization": {
            "type": "object",
            "additionalProperties": true,
            "required": ["policy"],
            "properties": {
              "policy": {
                "enum": [
                  "copy_exact",
                  "must_be_absent",
                  "render_at_fresh_attach",
                  "manifest_owned_state"
                ]
              },
              "mode_policy": {
                "description": "Narrow exception that copies the reviewed 100644 notice source/artifact and declares the installed target executable.",
                "const": "set_declared_executable"
              }
            }
          },
          "owned_state": { "type": "object" }
        },
        "allOf": [
          {
            "if": {
              "required": ["target_path"],
              "properties": {
                "target_path": {
                  "const": ".evozeus-wrapper/scripts/evozeus_notice.py"
                }
              }
            },
            "then": {
              "required": ["artifact_path", "source_path", "source_binding"],
              "properties": {
                "kind": { "const": "exact" },
                "mode": { "const": "100755" },
                "artifact_path": { "const": "artifacts/scripts/evozeus_notice.py" },
                "source_path": { "const": "scripts/evozeus_notice.py" },
                "materialization": {
                  "required": ["policy", "mode_policy"],
                  "properties": {
                    "policy": { "const": "copy_exact" },
                    "mode_policy": { "const": "set_declared_executable" }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "materialization": {
                  "not": { "required": ["mode_policy"] }
                }
              }
            }
          }
        ]
      }
    },
    "protected_business_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selector", "rule"],
        "properties": {
          "selector": { "const": "manifest.instruction_surface" },
          "rule": { "const": "byte_exact" }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
