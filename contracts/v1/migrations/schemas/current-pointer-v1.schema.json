{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MetaInFLow/EvoZeus-CoEvolve/contracts/v1/migrations/schemas/current-pointer-v1.schema.json",
  "title": "EvoZeus migration current pointer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pointer_id", "entries"],
  "properties": {
    "schema_version": {
      "const": "evozeus.coevolve.current-pointer.v1"
    },
    "pointer_id": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "path", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "sha256": { "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
